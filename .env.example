# ============================================================
# Veridex Environment Configuration Example (Local HydraDB)
# ============================================================

# ------------------------------------------------------------
# 1. Local HydraDB Configuration
# ------------------------------------------------------------
HYDRA_URL=http://127.0.0.1:8443
HYDRA_GRAPH=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0
HYDRA_TOKEN=local-development-token-32-bytes

# ------------------------------------------------------------
# 2. Google Gemini API Configuration (for grounded synthesis)
# ------------------------------------------------------------
# Optional in development (deterministic offline fallback active if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------
# 3. Server Configuration
# ------------------------------------------------------------
PORT=8000
