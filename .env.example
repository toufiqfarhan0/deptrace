# ============================================================
# Veridex Environment Configuration Example
# ============================================================

# ------------------------------------------------------------
# 1. Driver Mode Configuration
# ------------------------------------------------------------
# HYDRA_MODE selects the retrieval and tracing engine:
#   - 'local' (default): Local OpenCypher engine running at :8443 (recommended for CI/local dev)
#   - 'cloud': Managed HydraDB Cloud v2 API (production on Render)
HYDRA_MODE=local

# ------------------------------------------------------------
# 2. Local HydraDB Configuration (used when HYDRA_MODE=local)
# ------------------------------------------------------------
HYDRA_URL=http://127.0.0.1:8443
HYDRA_GRAPH=default
HYDRA_NAMESPACE=default
HYDRA_CELL_ID=cell-0
HYDRA_TOKEN=

# ------------------------------------------------------------
# 3. HydraDB Cloud v2 Configuration (used when HYDRA_MODE=cloud)
# ------------------------------------------------------------
# Required in production on Render. NEVER expose to frontend or git!
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=veridex-hackhydra
HYDRA_DB_BASE_URL=https://api.hydradb.com

# ------------------------------------------------------------
# 4. Google Gemini API Configuration (for grounded synthesis)
# ------------------------------------------------------------
# Optional in development (deterministic offline fallback active if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ------------------------------------------------------------
# 5. Server Configuration
# ------------------------------------------------------------
PORT=8000
