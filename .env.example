# ============================================================
# Veridex Environment Configuration Example (HydraDB Cloud)
# ============================================================

# ------------------------------------------------------------
# 1. Driver Mode Configuration
# ------------------------------------------------------------
# HYDRA_MODE selects the retrieval and tracing engine:
#   - 'cloud' (default/production): Managed HydraDB Cloud v2 API
#   - 'local' (optional offline test): Local OpenCypher engine running at :8443
HYDRA_MODE=cloud

# ------------------------------------------------------------
# 2. HydraDB Cloud v2 Configuration (Production)
# ------------------------------------------------------------
# Server-side Bearer authentication for HydraDB Cloud. NEVER expose to frontend or git!
HYDRA_DB_API_KEY=
HYDRA_DB_DATABASE=veridex-hackhydra
HYDRA_DB_BASE_URL=https://api.hydradb.com

# ------------------------------------------------------------
# 3. Google Gemini API Configuration (for grounded synthesis)
# ------------------------------------------------------------
# Server-side Gemini API key for grounded synthesis (deterministic offline fallback if omitted)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# ------------------------------------------------------------
# 4. Server Configuration
# ------------------------------------------------------------
PORT=8000

